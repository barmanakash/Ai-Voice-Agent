# Copy this file to ".env" and adjust. Never commit ".env".

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Seconds to wait for Ollama before giving up
OLLAMA_TIMEOUT=120
# Default context window (num_ctx) and how many previous messages to send
OLLAMA_CONTEXT_WINDOW=4096
HISTORY_LIMIT=20

# --- MongoDB (conversations, messages, document metadata) ---
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Never commit or share the real value; backend/.env is git-ignored.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=aria_chatbot
# Milliseconds to wait when looking for the MongoDB server (Atlas can take a few seconds)
MONGODB_TIMEOUT_MS=10000

# --- Document uploads ---
MAX_UPLOAD_MB=25
# How many documents may be processed at the same time
MAX_CONCURRENT_PROCESSING=2
